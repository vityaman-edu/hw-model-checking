MODULE main
  VAR
    this_ctrl : car_control();
    this : car(this_ctrl, 0.0, 0.0);

    that_ctrl : car_control();
    that : car(that_ctrl, 100.0, 0.0);

    cruise : cruise(this, that);

  LTLSPEC NAME safety := (G this.x < that.x);
  LTLSPEC NAME liveness := (G (that.x - this.x < 500.0));
  LTLSPEC NAME liveness500 := (G 500.0 < that.x -> F 500.0 < this.x);
  LTLSPEC NAME liveness1000 := (G 1000.0 < that.x -> F 1000.0 < this.x);
  LTLSPEC NAME liveness1500 := (G 1500.0 < that.x -> F 1500.0 < this.x);

MODULE car_control()
  DEFINE
    car_a_forward := 4.0;
    car_a_brake := 6.0;

    a_forward := k_accel * car_a_forward;
    a_brake := k_brake * car_a_brake;
    a := a_forward - a_brake;

  VAR
    k_accel : real;
    k_brake : real;

MODULE car(control, x_init, v_init)
  DEFINE
    a := control.a;

  VAR
    x : real;
    v : real;

  ASSIGN
    init(x) := x_init;
    next(x) := x + v;

    init(v) := v_init;
    next(v) := max (0, v + a);

MODULE cruise(this, that)
  DEFINE
    d_safe := 16.0;

    this_v_next := max (0, this.v + this.a);
    this_x_next := this.x + this.v + this_v_next;
    d := max (0, that.x - this_x_next - d_safe);

    a_smooth := 0.75 * this.control.car_a_brake;
    energy := 2.0 * a_smooth * d - this_v_next * this_v_next - this_v_next * a_smooth;
    a_req := energy / (2.0 * max (1.0, this_v_next));

    k_accel := max (0.0, min (1.0, a_req / this.control.car_a_forward));
    k_brake := max (0.0, min (1.0, - a_req / this.control.car_a_brake));

  ASSIGN
    init(this.control.k_accel) := 0.0;
    next(this.control.k_accel) := k_accel;

    init(this.control.k_brake) := 0.0;
    next(this.control.k_brake) := k_brake;

    init(that.control.k_accel) := 0.0;
    next(that.control.k_accel) := {0.0, 0.5, 1.0};

    init(that.control.k_brake) := 0.0;
    next(that.control.k_brake) := {0.0, 0.5, 1.0};
